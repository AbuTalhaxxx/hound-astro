---
import { ViewTransitions } from 'astro:transitions';
import '@fontsource-variable/space-grotesk';

const cookie = Astro.cookies.has("user");
let user = null;

if(cookie){
user = Astro.cookies.get("user").value;

}
else {
return Astro.redirect("/login");
}
let expanded = "";
if(Astro.cookies.has("expanded")){
const expanded = Astro.cookies.get("expanded").value;
console.log("Expanded "+ expanded);
}
else {
	Astro.cookies.set("expanded","false",{expire: 1});
}

expanded = Astro.cookies.get("expnaded");

const urlObject =new URL(Astro.request.url);
console.log(Astro.request.url);
const path = urlObject.pathname;
console.log(path);
let headerText = "";
switch(path){
case "/dashboard":
	 headerText = "OVERVIEW";
	 break;
case "/dashboard/emails":
	 headerText = "EMAILS";
	 break;
case "/dashboard/leads":
	 headerText = "LEADS";
	 break;
case "/dashboard/campaigns":
	 headerText = "CAMPAIGNS";
	 break;
case "/dashboard/templates":
	 headerText = "TEMPLATES";
	 break;
case "/dashboard/sequences":
   headerText = "SEQUENCES";
   break;
case "/dashboard/inbox":
   headerText = "INBOX";
   break;	   	 
default:
	break;

}
