<script>

import cookies from 'js-cookie';

  document.addEventListener('astro:page-load', () => {
    // This only runs once.
    
const expandable = document.querySelector(".expandable");
  const other = document.querySelector(".other");
  const logos = document.querySelectorAll(".logo");
  const logosHolder = document.querySelector(".logos-holder");
  const userLogo = document.querySelectorAll(".userlogo");

  

  userLogo.forEach((e)=>{

e.addEventListener("click",()=>{
  	console.log("clicked");
  	if(expandable.dataset.expanded==="true"){
  		cookies.set("expanded", false, {expires:1});
     logos.forEach((l)=>{
 l.classList.add("hidden");
  l.classList.remove("flex");
 }); 
      logosHolder.classList.add("flex");
 logosHolder.classList.remove("hidden");
  expandable.classList.add("w-[5%]");
 expandable.classList.remove("w-[24%]");
 other.classList.add("w-[91%]");
 other.classList.remove("w-[72%]");
 expandable.dataset.expanded="false";
  	}
  	else {
  		cookies.set("expanded", true, {expires:1});
 logos.forEach((l)=>{
 l.classList.add("flex");
 l.classList.remove("hidden");
 }); 	
 	 logosHolder.classList.add("hidden");
 logosHolder.classList.remove("flex");
  expandable.classList.add("w-[24%]");
 expandable.classList.remove("w-[5%]");
  other.classList.add("w-[72%]");
 other.classList.remove("w-[91%]");
 expandable.dataset.expanded="true";
  	}
  });

});

document.querySelector(".expandable").classList.remove("animate-pulse");

  }, { once: false });

 	

</script>
