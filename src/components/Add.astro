add.addEventListener("click",onClick);

addButton.addEventListener("click",async (e)=>{

e.stopPropagation();



if(componentType==="EMAIL"){
    const address = add.querySelector(".email-address").value;
    const password = add.querySelector(".password").value;
    const serverAddress = add.querySelector(".server-address").value;
    const portNumber = add.querySelector(".port-number").value;
if(address && password && serverAddress && portNumber){
   if(isValidEmail(address)&&isNumber(portNumber)){
   	let emails = data.emails;
   	if(emails.length>0){
   	let fileteredEmails = emails.filter((em)=>em.address===address);
   	if(fileteredEmails.length!==0){
   		return;
   	}
   }
   	await update(user,"emails",{
   		campaignName: "None",
   		address: address,
   		server:serverAddress,
   		password:password,
   		port:portNumber,
   	},"a");

   	window.location.reload();
   	
   }

}
else {
return;
}

}
else if(componentType==="TEMPLATE"){

    const name = add.querySelector(".template-name").value;
    const subject = add.querySelector(".email-subject").value;
    const content = add.querySelector(".content").value;
if(name && subject && content){
 
   	let templates = data.templates;
   	if(templates.length>0){
   	let fileteredTemplates = templates.filter((em)=>em.name===name);
   	if(fileteredTemplates.length!==0){
   		return;
   	}
    }
   	await update(user,"templates",{
   		campaignName: "None",
   		name: name,
   		subject:subject,
   	    content:content,
   	},"a");

   	window.location.reload();
   	
   

}
else {
return;
}


}
else if(componentType==="LIST"){
const listName = add.querySelector(".list-name").value;

if(listName){

let lists = data.lists;
if(lists.length>0){

	let fileteredLists = lists.filter((em)=>em.listName===listName);
   	if(fileteredLists.length!==0){
   		return;
   	}
}

await update(user,"lists",{
   		campaignName: "None",
   		listName: listName,
   		leads:[],
   	},"a");

   	window.location.reload();

}
else {
	return;
}

}
else if(componentType==="LEAD"){

 const fullname = add.querySelector(".fullname").value;
    const leadEmail = add.querySelector(".lead-email").value;
    const description = add.querySelector(".description").value;

if(fullname && leadEmail && description){

if(isValidEmail(leadEmail)){

let lists = data.lists.map((l)=>{

if(l.listName===listName){
l.leads.push({
campaignName:"None",
fullname:fullname,
email:leadEmail,
description:description,
});

return l;
}


});

await update(user,"lists",lists,"e");

window.location.reload();


}


}
	else {
		return;
	}

}
else if(componentType==="SEQUENCE"){
const sequenceName = add.querySelector(".sequence-name").value;

if(sequenceName){

let sequences = data.sequences;
if(sequences.length>0){

	let fileteredSequences = sequences.filter((em)=>em.name===sequenceName);
   	if(fileteredSequences.length!==0){
   		return;
   	}
}

await update(user,"sequences",{
   		validity: false,
   		name: sequenceName,
   	},"a");

   	window.location.reload();

}
else {
	return;
}

}
else if(componentType==="CAMPAIGN"){

const campaignName = add.querySelector(".campaign-name").value;
const interval = add.querySelector(".interval").value;
const sequence = add.querySelector(".seq-span").innerHTML;
const email = add.querySelector(".email-span").innerHTML;
const list = add.querySelector(".list-span").innerHTML;

console.log("here at the starting of campaign");

if(isNumber(interval)&&campaignName&&email&&list&&sequence&&sequence!=="SEQUENCE"&&list!=="LIST"&&email!=="EMAIL"){
	let campaigns = data.campaigns;

    if(campaigns.length>0){

	let fileteredCampaigns = campaigns.filter((em)=>em.name===campaignName);
   	if(fileteredCampaigns.length!==0){
   		return;
   	   }
    }
    console.log("updating");
    await update(user,"campaigns",{
   		name: campaignName,
   		sequence: sequence,
   		list: list,
   		email: email,
   		interval: interval,
   		status:false,
   	},"a");

   	window.location.reload();


}
else {
	return;
}

}

mainContainer.classList.add("hidden");
	mainContainer.classList.remove("flex");
	add.classList.add('max-h-[70px]');
	add.classList.remove('max-h-[500px]');
	add.removeAttribute('data-open');
	addButton.classList.add('opacity-0');
	addButton.classList.remove('opacity-100');

});

add.classList.remove("animate-pulse");

};

setUp();

document.addEventListener('astro:page-load',setUp,{once:false});


</script>