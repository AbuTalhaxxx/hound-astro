  e.stopPropagation();
	});
}
else if(componentType==="LEAD"){
	console.log("about to add listener");
	 contentArea = add.querySelector(".description");
	contentArea.addEventListener("click",(e)=>{
  console.log("inside the textarea");
  e.stopPropagation();

	});
}
else if(componentType==="CAMPAIGN"){
const seqSpan = mainContainer.querySelector(".seq-span");
const con = mainContainer.querySelector(".seq-con");
