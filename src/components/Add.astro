		    	<span class="pl-[15px] text-white mix-blend-overlay email-span">EMAIL</span>
		    	<img src="/chevdown.png" class="h-[12px] w-[24px] transition-transform origin-center email-chev duration-300 mix-blend-overlay"/>
		    </div>
		    <div class="email-options hidden max-h-[180px] overflow-scroll rounded-b-[7px] scrollbar-hide">
		    	{addresses ? addresses.map((m,i)=>{
		    		if(i===addresses.length-1){
                    return (<div class={`option-${i} flex flex-row items-center w-full h-[50px] border-t-[1px] hover:opacity-10 border-[#BABABA0A]`}>
