                    return (<div class={`option-${i} flex flex-row items-center w-full h-[50px] border-t-[1px] hover:opacity-10 border-b-[1px] border-[#BABABA0A]`}>
                    <span class="text-[12px] font-grotesk text-white pl-[15px] mix-blend-overlay text-white">{m}</span>
                    </div>);
		    	}):""}
		    </div>
		</div>
