		    	<span class="pl-[15px] text-white mix-blend-overlay list-span">LIST</span>
		    	<img src="/chevdown.png" class="h-[12px] w-[24px] transition-transform origin-center list-chev duration-300 mix-blend-overlay"/>
		    </div>
		    <div class="list-options hidden max-h-[180px] overflow-scroll rounded-b-[7px] scrollbar-hide">
		    	{lists ? lists.map((m,i)=>{
		    		if(i===lists.length-1){
                    return (<div class={`option-${i} flex flex-row items-center w-full h-[50px] border-t-[1px] hover:opacity-10 border-[#BABABA0A]`}>
                    <span class="text-[12px] font-grotesk text-white pl-[15px] mix-blend-overlay text-white">{m}</span>
