		    <div class="w-full h-[50px] template-selector rounded-[7px] flex flex-row justify-between items-center">
		    	<span class="pl-[15px] text-white mix-blend-overlay seq-span">SEQUENCE</span>
		    	<img src="/chevdown.png" class="h-[12px] w-[24px] transition-transform origin-center seq-chev duration-300 mix-blend-overlay"/>
		    </div>
		    <div class="template-options hidden max-h-[180px] overflow-scroll rounded-b-[7px] scrollbar-hide">
