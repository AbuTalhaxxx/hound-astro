---
/**
 * The templates page.
 * It displays a list of templates and allows the user to add new ones.
 */
import MainLayout from '../../components/MainLayout.astro';
import Add from '../../components/Add.astro';
import Item from '../../components/Item.astro';
import '@fontsource-variable/syne';
import { getData } from '../../firebase/firebaseUtils.js';

let templates = null;

if(Astro.cookies.has("user")){

const data = await getData(Astro.cookies.get("user").value);

templates = data.templates;

}
else {
	    return Astro.redirect("/login");
}


---

<MainLayout>
<Add componentType="TEMPLATE"/>
{templates.length > 0 ? templates.map((item, index)=>{
    return <Item active={item.campaignName === "None" ? false : true} index={index+1} componentType="TEMPLATE" name={item.name} subject={item.subject} contentname={item.content} />; 
}):""}
</MainLayout>

<script>

	
</script>