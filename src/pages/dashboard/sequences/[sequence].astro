editor.on("nodeCreated",(id)=>{

const createdNode = document.getElementById("node-"+id);
if(createdNode.classList.contains("enode")){

const selectedValue = createdNode.querySelector(".selected-value");

const templateSelector = createdNode.querySelector(".template-selector");

const active = createdNode.querySelector(".active");
const inactive = createdNode.querySelector(".inactive");

active.addEventListener("click",(eve)=>{
eve.stopPropagation();

inactive.classList.remove("hidden");
active.classList.add("hidden");

});

inactive.addEventListener("click",()=>{
active.classList.remove("hidden");	
inactive.classList.add("hidden");
});

templateSelector.addEventListener("click",(e)=>{
e.stopPropagation();

const arrow = templateSelector.querySelector(".arrow");

if(arrow.classList.contains("rotate-[180deg]")){
	arrow.classList.remove("rotate-[180deg]");
}
else {
	arrow.classList.add("rotate-[180deg]");
}

const tempOptions = templateSelector.querySelector(".template-options");
if(tempOptions.classList.contains("hidden")){
	tempOptions.classList.remove("hidden");
}
else {
	tempOptions.classList.add("hidden");
}

const selectableOptions = tempOptions.querySelectorAll(".option");

const spreadedOptions = [...selectableOptions];

spreadedOptions.forEach((o)=>{

o.addEventListener("click",(ev)=>{
ev.stopPropagation();
if(selectedValue.innerHTML==="TEMPLATE"){
selectedValue.innerHTML = ev.target.innerHTML;
templates = templates.filter((op)=>op!==ev.target.innerHTML);
tempOptions.removeChild(ev.target);
}
else {
	templates.push(selectedValue.innerHTML);
	const existingValue = selectedValue.innerHTML;
	selectedValue.innerHTML = ev.target.innerHTML;
templates = templates.filter((op)=>op!==ev.target.innerHTML);
ev.target.innerHTML = existingValue;
}

});

});

});

}
else if(createdNode.classList.contains("replynode")){

const activeInbox = createdNode.querySelector(".active-inbox");
const inactiveInbox = createdNode.querySelector(".inactive-inbox");
const activeAi = createdNode.querySelector(".active-ai");
const inactiveAi = createdNode.querySelector(".inactive-ai");

activeInbox.addEventListener("click",(e)=>{

e.stopPropagation();

activeInbox.classList.add("hidden");
activeInbox.classList.remove("inline-block");
inactiveInbox.classList.add("inline-block");
inactiveInbox.classList.remove("hidden");


});

inactiveInbox.addEventListener("click",(e)=>{
e.stopPropagation();

inactiveInbox.classList.add("hidden");
inactiveInbox.classList.remove("inline-block");
activeInbox.classList.add("inline-block");
activeInbox.classList.remove("hidden");

activeAi.classList.add("hidden");
activeAi.classList.remove("inline-block");
inactiveAi.classList.add("inline-block");
inactiveAi.classList.remove("hidden");
if(createdNode.classList.contains("added")){

editor.removeNodeOutput(id, "output_1");
editor.removeNodeOutput(id, "output_1");
editor.removeNodeOutput(id, "output_1");
createdNode.classList.remove("added");
}


});

inactiveAi.addEventListener("click",(e)=>{
e.stopPropagation();

inactiveAi.classList.add("hidden");
inactiveAi.classList.remove("inline-block");
activeAi.classList.add("inline-block");
activeAi.classList.remove("hidden");

activeInbox.classList.add("hidden");
activeInbox.classList.remove("inline-block");
inactiveInbox.classList.add("inline-block");
inactiveInbox.classList.remove("hidden");
if(!createdNode.classList.contains("added")){
editor.addNodeOutput(id);
editor.addNodeOutput(id);
editor.addNodeOutput(id);
createdNode.classList.add("added");
}

});

activeAi.addEventListener("click",(e)=>{

