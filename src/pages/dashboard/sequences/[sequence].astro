</svg>
<button class="save-button bg-header rounded-[10px] text-[12px] font-grotesk h-[30px] w-[70px]">
	SAVE
</button>
	</div>
</body>
</html>	
<script>
import Drawflow from 'drawflow';
import { getData, update, isNumber, isValidEmail } from '../../../firebase/firebaseUtils.js';
import cookies from "js-cookie";
const user = cookies.get("user");
const data = await getData(user);
const currentPath = window.location.pathname;
const splitted = currentPath.split("/");
const sequenceName = splitted[splitted.length-1];
let templates = data.templates.map((t)=>t.name);
console.log(templates);

let id = document.getElementById("drawflow");
const editor = new Drawflow(id);
editor.zoom_max = 1.6;
editor.zoom_min = 0.5;
editor.zoom_value = 0.1;


const addNodeActive = document.querySelector(".add-node.active");
const addNodeInactive = document.querySelector(".add-node.inactive");
const nodeSelector = document.querySelector(".node-selector");
const zoomIn = document.querySelector(".zoom-in");
const zoomOut = document.querySelector(".zoom-out");
const opened = document.querySelector(".opened");
const noreply = document.querySelector(".no-reply");
const reply = document.querySelector(".reply");
const email = document.querySelector(".email");
const save = document.querySelector(".save-button");
const backbutton = document.querySelector(".back-button");

backbutton.addEventListener("click",async ()=>{

const exportedData = editor.export();
let sequences = data.sequences.map((s)=>{
if(s.name===sequenceName){
	s.flow = exportedData;
  s.validity = validateFlow(exportedData);
}

return s;
});

await update(user,"sequences", sequences,"e");

history.back();

});

let flow = {};

zoomIn.addEventListener("click",(e)=>{

e.stopPropagation();

editor.zoom_in();

console.log("zoom in");

});

zoomOut.addEventListener("click",(e)=>{

e.stopPropagation();

editor.zoom_out();

console.log("zoom out");

});

addNodeActive.addEventListener("click",()=>{
addNodeActive.classList.add("hidden");
