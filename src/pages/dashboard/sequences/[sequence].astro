import '@fontsource-variable/syne';
import 'drawflow/dist/drawflow.min.css';

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content="{Astro.generator}" />
		<title>Astro</title>
		<style is:global>
	
.drawflow .drawflow-node {
display:block;
border-radius: 8px;
background-color: rgba(186,186,186,0.04);
width: 200px;
max-height: 400px;
border: 1px solid rgba(255, 255, 255, 0.02); 
padding:0px;
}

.drawflow .drawflow-node.selected {

background-color: rgba(186,186,186,0.04);

}

.drawflow .replynode .input {
top: 18px;
left: -2px;
width: 3px;
height:3px;
rotate: 45deg;
background-color: #798388;
border-radius: 0;
border: none;

}

.drawflow .replynode .output {
right: -197px;
top: -75px;
width: 3px;
height:3px;
rotate: 45deg;
background-color: #798388;
border-radius: 0;
border: none;
}

.drawflow .noreply .output, .drawflow .opened .output {
right: -197px;
top: -50px;
width: 3px;
height:3px;
rotate: 45deg;
background-color: #798388;
border-radius: 0;
border: none;
}


.drawflow .spreaded .output {
right: -197px;
top: -131px;
width: 3px;
height:3px;
rotate: 45deg;
background-color: #798388;
border-radius: 0;
border: none;
}

.drawflow .noreply .input, .drawflow .opened .input {
top: 18px;
left: -2px;
width: 3px;
height:3px;
rotate: 45deg;
background-color: #798388;
border-radius: 0;
border: none;

}

.drawflow .enode .output {
right: -197px;
top: -135px;
width: 3px;
height:3px;
rotate: 45deg;
background-color: #798388;
border-radius: 0;
border: none;
}

.drawflow .enode .input {
left: -2px;
top: 15px;
width: 3px;
height:3px;
rotate: 45deg;
background-color: #798388;
border-radius: 0;
border: none;
}

.drawflow .drawflow-node .inputs, .drawflow .drawflow-node .outputs {
	height: 0;
}

	.drawflow .connection .main-path {
	stroke-width: 1px;
	stroke: rgba(255,255,255,0.4);
}


</style>
	</head>
